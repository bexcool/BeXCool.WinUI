<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="BeXCool.WinUI.TestingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BeXCool.WinUI.TestingApp"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:bControls="using:BeXCool.WinUI.Controls"
        mc:Ignorable="d"
        Title="BeXCool.WinUI.TestingApp">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <StackPanel>
            <TextBlock Text="Testing BeXCool.WinUI.Controls"
                       FontSize="24"
                       Margin="10" />
            <bControls:Badge HorizontalAlignment="Center"
                             BadgeBrush="LimeGreen">
                Test
            </bControls:Badge>

            <!-- WHAT'S NEW - every button creates a new controller from the version, so the cache is read again -->
            <StackPanel Margin="10,24,10,10"
                        Spacing="8">
                <TextBlock Text="What's new"
                           Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBox x:Name="WhatsNewVersionTextBox"
                         Header="App version"
                         Text="1.4.1"
                         Width="200"
                         HorizontalAlignment="Left"
                         TextChanged="WhatsNewVersionTextBox_TextChanged" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <Button Content="Show"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="ShowWhatsNewButton_Click" />
                    <Button Content="Show if new"
                            Click="ShowWhatsNewIfNewButton_Click" />
                    <Button Content="Forget seen version"
                            Click="ForgetWhatsNewButton_Click" />
                </StackPanel>
                <TextBlock x:Name="WhatsNewStatusTextBlock"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsTextSelectionEnabled="True" />
                <TextBlock x:Name="WhatsNewActionTextBlock"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
