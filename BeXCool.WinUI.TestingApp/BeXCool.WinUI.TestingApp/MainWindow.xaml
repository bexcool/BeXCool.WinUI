<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="BeXCool.WinUI.TestingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BeXCool.WinUI.TestingApp"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:bControls="using:BeXCool.WinUI.Controls"
        mc:Ignorable="d"
        Title="BeXCool.WinUI.TestingApp">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <StackPanel>
            <TextBlock Text="Testing BeXCool.WinUI.Controls"
                       FontSize="24"
                       Margin="10" />
            <bControls:Badge HorizontalAlignment="Center"
                             BadgeBrush="LimeGreen">
                Test
            </bControls:Badge>
        </StackPanel>
    </Grid>
</Window>
