<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="BeXCool.WinUI.Controls.WhatsNewDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:BeXCool.WinUI.Controls"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               mc:Ignorable="d">

    <ContentDialog.Resources>
        <!-- The defaults (548 x 756) are too small for the list next to the card, the real size is set on RootGrid -->
        <x:Double x:Key="ContentDialogMaxWidth">1600</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">1200</x:Double>
    </ContentDialog.Resources>

    <!-- No dialog buttons and no Title, the header with the close button is part of the content -->
    <Grid x:Name="RootGrid"
          RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{x:Bind Header, Mode=OneWay}"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center"
                       TextWrapping="WrapWholeWords" />

            <!-- Pulled into the dialog padding to sit close to the corner -->
            <Button Grid.Column="1"
                    Width="36"
                    Height="36"
                    Margin="0,-8,-12,-8"
                    Padding="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtleButtonStyle}"
                    AutomationProperties.Name="{x:Bind CloseButtonToolTip, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind CloseButtonToolTip, Mode=OneWay}"
                    Click="CloseButton_Click">
                <FontIcon Glyph="&#xE711;"
                          FontSize="12" />
            </Button>
        </Grid>

        <local:WhatsNewView x:Name="ContentView"
                            Grid.Row="1"
                            ActionInvoked="ContentView_ActionInvoked" />
    </Grid>
</ContentDialog>
